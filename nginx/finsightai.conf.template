# Nginx reverse proxy example for FinSight AI
# Place this in /etc/nginx/sites-available/finsightai and symlink to sites-enabled

server {
    listen 80;
    server_name example.com; # REPLACE with your domain

    access_log /var/log/nginx/finsightai.access.log;
    error_log  /var/log/nginx/finsightai.error.log;

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase timeouts for Streamlit long-polling
        proxy_connect_timeout 60s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;

        # Websockets support
        proxy_set_header Connection "";
    }

    # Optional: serve static files if needed
    location /static/ {
        root /var/www/finsightai;
    }
}
